{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mitulamin/ai-sdlc-loop/data/schemas/skill-principle-map.schema.json",
  "title": "Skill to principle map",
  "description": "One entry per amalgamated skill: its folder, the principle it implements, and where it sits in the taxonomy and the test runs. The single source for wiring agents and commands to skills by ID.",
  "type": "object",
  "required": [
    "schema_version",
    "skills"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "skills": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "folder",
          "skill_name",
          "principle_id",
          "aliases",
          "category",
          "phase",
          "test_app",
          "slot",
          "licence_status",
          "clean_sources",
          "link_only_sources",
          "status"
        ],
        "properties": {
          "folder": {
            "type": "string",
            "pattern": "^skills/[0-9]+\\.[0-9]+-[a-z0-9-]+$"
          },
          "skill_name": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "principle_id": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+$"
          },
          "aliases": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[0-9]+\\.[0-9]+$"
            },
            "description": "Retired IDs merged into this principle; must match aliases in data/principles.json"
          },
          "category": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
            "description": "slug of a category in data/principles.json"
          },
          "phase": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
            "description": "slug of a phase in data/taxonomy.json"
          },
          "test_app": {
            "enum": [
              "A",
              "B",
              "C",
              "All"
            ]
          },
          "slot": {
            "type": "integer",
            "minimum": 1
          },
          "licence_status": {
            "type": "string",
            "minLength": 1
          },
          "clean_sources": {
            "type": "integer",
            "minimum": 0
          },
          "link_only_sources": {
            "type": "integer",
            "minimum": 0
          },
          "status": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
