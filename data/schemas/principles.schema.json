{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mitulamin/ai-sdlc-loop/data/schemas/principles.schema.json",
  "title": "Principles",
  "description": "The canonical list of principles. Hand-edited source of truth; principles/*.md is generated from it.",
  "type": "object",
  "required": ["schema_version", "categories", "principles"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "categories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["number", "slug", "name"],
        "additionalProperties": false,
        "properties": {
          "number": { "type": "integer", "minimum": 1 },
          "slug": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
          "name": { "type": "string", "minLength": 1 }
        }
      }
    },
    "principles": {
      "type": "array",
      "items": { "$ref": "#/$defs/principle" }
    }
  },
  "$defs": {
    "principle": {
      "type": "object",
      "required": ["id", "category", "number", "statement", "sources", "status", "provenance"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$", "description": "category number, a dot, then the number within the category" },
        "category": { "type": "string", "description": "slug of an entry in categories" },
        "number": { "type": "integer", "minimum": 1 },
        "statement": { "type": "string", "minLength": 1 },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "description": "Source labels as written in the research. Each label must resolve to a repo through labels in data/sources.json."
        },
        "status": { "enum": ["active", "merged", "dropped"] },
        "provenance": {
          "type": "object",
          "required": ["origin", "research_run", "merged_from", "notes"],
          "additionalProperties": false,
          "properties": {
            "origin": { "enum": ["initial-research", "refresh", "contributed"] },
            "research_run": { "type": "string", "description": "id of the research run that introduced this principle" },
            "merged_from": { "type": "array", "items": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" } },
            "notes": { "type": "string" }
          }
        }
      }
    }
  }
}
