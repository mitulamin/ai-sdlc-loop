{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mitulamin/ai-sdlc-loop/data/schemas/principles.schema.json",
  "title": "Principles index",
  "description": "Schema 2.0.0, for the amalgamated-skills kit layout. The 103 live principles, their categories, and the aliases that resolve retired IDs to their survivor. IDs are never renumbered.",
  "type": "object",
  "required": ["version", "count", "categories", "aliases", "principles"],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "string", "format": "date", "description": "Date of the kit or import this file comes from." },
    "count": { "type": "integer", "minimum": 0 },
    "note": { "type": "string" },
    "categories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "integer", "minimum": 1 },
          "name": { "type": "string", "minLength": 1 }
        }
      }
    },
    "aliases": {
      "type": "object",
      "description": "Retired ID to survivor ID.",
      "propertyNames": { "$ref": "#/$defs/id" },
      "additionalProperties": { "$ref": "#/$defs/id" }
    },
    "principles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "category", "category_name", "subgroup", "statement", "previous_statement", "aliases", "skill", "skill_folder", "partial_overlap_with"],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "category": { "type": "integer", "minimum": 1 },
          "category_name": { "type": "string", "minLength": 1 },
          "subgroup": { "type": ["string", "null"] },
          "statement": { "type": "string", "minLength": 1 },
          "previous_statement": { "type": ["string", "null"], "description": "The survivor's wording before a merge changed it." },
          "aliases": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "statement"],
              "additionalProperties": false,
              "properties": {
                "id": { "$ref": "#/$defs/id" },
                "statement": { "type": "string", "minLength": 1, "description": "The retired principle's statement, for the record." }
              }
            }
          },
          "skill": { "type": "string", "pattern": "^\\d+\\.\\d+-[a-z0-9-]+$" },
          "skill_folder": { "type": "string", "pattern": "^skills/\\d+\\.\\d+-[a-z0-9-]+$" },
          "partial_overlap_with": { "anyOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] }
        }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^\\d+\\.\\d+$" }
  }
}
